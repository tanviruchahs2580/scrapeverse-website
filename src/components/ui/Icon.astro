---
/**
 * Single-source icon registry. Replaces the previous mix of hand-pasted SVGs
 * and emoji, which rendered inconsistently and were announced as text by
 * screen readers. All glyphs are decorative by default (`aria-hidden`) — the
 * meaning always lives in adjacent text.
 *
 * `IconName` is derived from `PATHS` rather than hand-listed. A separate union
 * silently drifts out of sync and every addition becomes a type error.
 */

const PATHS = {
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3.2 9h17.6M3.2 15h17.6"/><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"/>',
  code: '<path d="M8.5 8.5 4 12l4.5 3.5"/><path d="M15.5 8.5 20 12l-4.5 3.5"/><path d="M13.5 5.5 10.5 18.5"/>',
  shield:
    '<path d="M12 3l7.5 3v6c0 4.2-3 7.7-7.5 9-4.5-1.3-7.5-4.8-7.5-9V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
  filter: '<path d="M3.5 5.5h17l-6.6 7.6V19l-3.8 2v-7.9z"/>',
  layers:
    '<path d="m12 3 8.5 4.5L12 12 3.5 7.5z"/><path d="m3.5 12.2 8.5 4.5 8.5-4.5"/><path d="m3.5 16.7 8.5 4.5 8.5-4.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7.2V12l3.2 1.9"/>',
  lock: '<rect x="4.5" y="10" width="15" height="10.5" rx="2.2"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10"/><path d="M12 14v2.6"/>',
  scale:
    '<path d="M12 4v16"/><path d="M6 8h12"/><path d="M6 8 3.2 14.5h5.6z"/><path d="M18 8l-2.8 6.5h5.6z"/><path d="M8.5 20h7"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  minus: '<path d="M5 12h14"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
  'arrow-right': '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M8.5 7H17v8.5"/>',
  'chevron-down': '<path d="m6 9.5 6 6 6-6"/>',
  'chevron-left': '<path d="m14.5 6-6 6 6 6"/>',
  'chevron-right': '<path d="m9.5 6 6 6-6 6"/>',
  menu: '<path d="M3.5 7h17"/><path d="M3.5 12h17"/><path d="M3.5 17h17"/>',
  close: '<path d="M6 6l12 12"/><path d="M18 6 6 18"/>',
  download: '<path d="M12 3.5v11"/><path d="m7.5 10.5 4.5 4.5 4.5-4.5"/><path d="M4.5 19.5h15"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="2.2"/><path d="m3.8 7 8.2 6 8.2-6"/>',
  alert: '<circle cx="12" cy="12" r="9"/><path d="M12 7.8v4.8"/><path d="M12 15.8h.01"/>',
  sparkle:
    '<path d="M12 3.5 13.7 9l5.5 1.7-5.5 1.7L12 18l-1.7-5.6L4.8 10.7 10.3 9z"/><path d="M18.5 15.5 19.2 18l2.3.7-2.3.7-.7 2.3-.7-2.3-2.3-.7 2.3-.7z"/>',
  play: '<path d="M8 5.5 18 12 8 18.5z"/>',
  linkedin:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="2.4"/><path d="M8 10.5v6"/><path d="M8 7.8h.01"/><path d="M12 16.5v-3.4a2.1 2.1 0 0 1 4.2 0v3.4"/><path d="M12 10.5v6"/>',
  github:
    '<path d="M9 20.5c-4 1.2-4-2.2-5.6-2.7m11.2 5.2v-3.3c0-.9.1-1.2-.4-1.8 2.4-.3 4.9-1.2 4.9-5.3a4.1 4.1 0 0 0-1.1-2.9 3.8 3.8 0 0 0-.1-2.8s-.9-.3-3 1.1a10.3 10.3 0 0 0-5.4 0c-2.1-1.4-3-1.1-3-1.1a3.8 3.8 0 0 0-.1 2.8 4.1 4.1 0 0 0 1.1 2.9c0 4.1 2.5 5 4.9 5.3-.4.4-.5.9-.5 1.5v3.4"/>',
  x: '<path d="M4 4h3.6l4.4 6.2L17.4 4H20l-6.7 8.4L20 20h-3.6l-4.7-6.6L6.6 20H4l6.9-8.7z"/>',
} as const;

export type IconName = keyof typeof PATHS;

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  /** Provide when the icon is the only label for a control. */
  title?: string;
}

const { name, class: className = '', size = 20, title } = Astro.props;

// `set:html` replaces children, so the optional <title> is prepended here.
const body = title ? `<title>${title}</title>${PATHS[name]}` : PATHS[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className || undefined}
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  focusable="false"
  set:html={body}
/>
