---
import Button from '~/components/ui/Button.astro';
import Icon from '~/components/ui/Icon.astro';
import type { Dictionary } from '~/i18n';
import type { Locale } from '~/i18n';

interface Props {
  dict: Dictionary;
  locale: Locale;
}

const { dict, locale } = Astro.props;
const form = dict.form;
const privacyHref = locale === 'en' ? '/privacy/' : '/bd/privacy/';
const thanksHref = locale === 'en' ? '/thanks/' : '/bd/thanks/';

/** Only valid at build time; the client refreshes it on submit for the timing trap. */
const builtAt = Date.now();
---

<section id="request" aria-labelledby="request-heading" class="relative scroll-mt-28">
  <div class="shell">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow inline-flex items-center gap-2 rounded-full border border-line-strong bg-ink-900/70 px-3.5 py-1.5 backdrop-blur-sm">
        {dict.stickyCta.label}
      </p>
      <h2 id="request-heading" class="mt-7 text-h2 font-semibold text-fg">
        {form.title}
      </h2>
      <p class="mt-4 text-lead text-fg-muted">{form.subtitle}</p>
    </div>

    <div class="mx-auto mt-12 max-w-3xl lg:mt-14" data-reveal>
      <!-- ============================ Form ============================ -->
      <form
        id="request-form"
        name="request"
        method="POST"
        action={thanksHref}
        novalidate
        data-wizard
        data-netlify="true"
        data-netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="request" />
        <input type="hidden" name="locale" value={locale} />
        <input type="hidden" name="page-url" value="/" data-page-url />
        <input type="hidden" name="started-at" value={String(builtAt)} data-started-at />

        <!-- Spam trap: hidden from humans, irresistible to bots. -->
        <div class="hp" aria-hidden="true">
          <label>
            Do not fill this in <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <!-- Step progress -->
        <ol class="steps" role="list">
          {form.stepLabels.map((label, index) => (
            <li class="step" data-step-indicator={index + 1}>
              <span class="step-dot" aria-hidden="true">
                {index + 1}
              </span>
              <span class="step-label">{label}</span>
            </li>
          ))}
        </ol>
        <div class="step-track" aria-hidden="true">
          <span data-step-bar></span>
        </div>

        <div class="mt-8 rounded-[var(--radius-panel)] border border-line-strong bg-ink-900/60 p-6 backdrop-blur-sm sm:p-9">
          <!-- Per-step error summary, announced politely. -->
          <p class="alert" role="alert" data-error-summary hidden></p>

          <!-- ---------------------------- Step 1 ---------------------------- -->
          <div data-step="1">
            <h3 class="step-heading" tabindex="-1" data-step-heading>
              <span class="step-kicker">{form.stepLabels[0]}</span>
              {form.step1.heading}
            </h3>
            <p class="step-help">{form.step1.help}</p>

            <fieldset class="field-group" data-validate="dataType">
              <legend>{form.step1.dataTypeLabel}</legend>
              <div class="chip-grid">
                {form.step1.dataTypes.map((type) => (
                  <label class="chip">
                    <input type="checkbox" name="dataType" value={type.id} data-field="dataType" />
                    <span>{type.label}</span>
                  </label>
                ))}
              </div>
              <p class="field-error" data-error-for="dataType" hidden></p>
            </fieldset>

            <fieldset class="field-group" data-validate="volume">
              <legend>{form.step1.volumeLabel}</legend>
              <div class="stack">
                {form.step1.volumes.map((volume, index) => (
                  <label class="radio">
                    <input
                      type="radio"
                      name="volume"
                      value={volume}
                      data-field="volume"
                      required={index === 0}
                    />
                    <span>{volume}</span>
                  </label>
                ))}
              </div>
              <p class="field-error" data-error-for="volume" hidden></p>
            </fieldset>

            <fieldset class="field-group" data-validate="frequency">
              <legend>{form.step1.frequencyLabel}</legend>
              <div class="stack">
                {form.step1.frequencies.map((frequency, index) => (
                  <label class="radio">
                    <input
                      type="radio"
                      name="frequency"
                      value={frequency}
                      data-field="frequency"
                      required={index === 0}
                    />
                    <span>{frequency}</span>
                  </label>
                ))}
              </div>
              <p class="field-error" data-error-for="frequency" hidden></p>
            </fieldset>

            <div class="field-group">
              <label for="notes">{form.step1.notesLabel}</label>
              <textarea
                id="notes"
                name="notes"
                rows="4"
                placeholder={form.step1.notesPlaceholder}
                data-field="notes"
              ></textarea>
            </div>
          </div>

          <!-- ---------------------------- Step 2 ---------------------------- -->
          <div data-step="2" hidden>
            <h3 class="step-heading" tabindex="-1" data-step-heading>
              <span class="step-kicker">{form.stepLabels[1]}</span>
              {form.step2.heading}
            </h3>
            <p class="step-help">{form.step2.help}</p>

            <div class="field-group">
              <label for="url">
                {form.step2.urlLabel}{' '}
                <span class="req" aria-hidden="true">
                  *
                </span>
              </label>
              <input
                id="url"
                name="url"
                type="url"
                inputmode="url"
                autocomplete="url"
                placeholder={form.step2.urlPlaceholder}
                required
                aria-describedby="url-hint url-error"
                data-field="url"
                data-validate="url"
              />
              <p class="field-hint" id="url-hint">
                {form.step2.urlHint}
              </p>
              <p class="field-error" id="url-error" data-error-for="url" hidden></p>
            </div>

            <div class="field-group">
              <label for="urlExtra">{form.step2.urlExtraLabel}</label>
              <textarea id="urlExtra" name="urlExtra" rows="3" data-field="urlExtra"></textarea>
            </div>

            <fieldset class="field-group" data-validate="antiBot">
              <legend>{form.step2.antiBotLabel}</legend>
              <div class="stack">
                {form.step2.antiBotOptions.map((option, index) => (
                  <label class="radio">
                    <input
                      type="radio"
                      name="antiBot"
                      value={option.id}
                      data-field="antiBot"
                      required={index === 0}
                    />
                    <span>{option.label}</span>
                  </label>
                ))}
              </div>
              <p class="field-error" data-error-for="antiBot" hidden></p>
            </fieldset>
          </div>

          <!-- ---------------------------- Step 3 ---------------------------- -->
          <div data-step="3" hidden>
            <h3 class="step-heading" tabindex="-1" data-step-heading>
              <span class="step-kicker">{form.stepLabels[2]}</span>
              {form.step3.heading}
            </h3>

            <div class="grid gap-6 sm:grid-cols-2">
              <div class="field-group">
                <label for="name">
                  {form.step3.nameLabel}{' '}
                  <span class="req" aria-hidden="true">
                    *
                  </span>
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  placeholder={form.step3.namePlaceholder}
                  required
                  aria-describedby="name-error"
                  data-field="name"
                  data-validate="name"
                />
                <p class="field-error" id="name-error" data-error-for="name" hidden></p>
              </div>

              <div class="field-group">
                <label for="email">
                  {form.step3.emailLabel}{' '}
                  <span class="req" aria-hidden="true">
                    *
                  </span>
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  inputmode="email"
                  autocomplete="email"
                  placeholder={form.step3.emailPlaceholder}
                  required
                  aria-describedby="email-error"
                  data-field="email"
                  data-validate="email"
                />
                <p class="field-error" id="email-error" data-error-for="email" hidden></p>
              </div>
            </div>

            <div class="field-group">
              <label for="company">{form.step3.companyLabel}</label>
              <input
                id="company"
                name="company"
                type="text"
                autocomplete="organization"
                placeholder={form.step3.companyPlaceholder}
                data-field="company"
              />
            </div>

            <div class="field-group">
              <label for="budget">{form.step3.budgetLabel}</label>
              <select id="budget" name="budget" data-field="budget">
                <option value="">—</option>
                {form.step3.budgets.map((budget) => (
                  <option value={budget}>{budget}</option>
                ))}
              </select>
            </div>

            <div class="field-group" data-validate="consent">
              <label class="check">
                <input
                  type="checkbox"
                  name="consent"
                  value="yes"
                  required
                  aria-describedby="consent-error"
                  data-field="consent"
                />
                <span>
                  {form.step3.consentText}{' '}
                  <a href={privacyHref} class="link">
                    {form.step3.consentLink}
                  </a>
                </span>
              </label>
              <p class="field-error" id="consent-error" data-error-for="consent" hidden></p>
            </div>
          </div>

          <!-- --------------------------- Navigation -------------------------- -->
          <div class="mt-9 flex items-center justify-between gap-4 border-t border-line pt-7">
            <Button
              id="wizard-back"
              variant="ghost"
              icon="chevron-left"
              type="button"
              class="back-btn"
            >
              {form.back}
            </Button>

            <div class="flex items-center gap-3">
              <Button
                id="wizard-next"
                variant="primary"
                type="button"
                class="next-btn"
                icon="arrow-right"
                track="form_next"
              >
                {form.next}
              </Button>

              <Button
                id="wizard-submit"
                variant="primary"
                type="submit"
                class="submit-btn"
                icon="check"
                track="form_submit"
              >
                <span data-submit-label>{form.submit}</span>
              </Button>
            </div>
          </div>
        </div>
      </form>

      <!-- Localised runtime strings for the wizard. JSON in a script tag is
           escaped by Astro's set:html and never executed. -->
      <script
        type="application/json"
        data-wizard-strings
        is:inline
        set:html={JSON.stringify({
          back: form.back,
          next: form.next,
          submit: form.submit,
          submitting: form.submitting,
          generic: form.errors.generic,
          errors: {
            dataType: form.errors.dataType,
            volume: form.errors.volume,
            frequency: form.errors.frequency,
            antiBot: form.errors.antiBot,
            url: form.errors.url,
            email: form.errors.email,
            name: form.errors.name,
            consent: form.errors.consent,
          },
        })}
      />
      <!-- ============================ Success ============================ -->
      <div
        class="success rounded-[var(--radius-panel)] border border-brand-500/35 bg-gradient-to-b from-brand-500/10 to-ink-900/60 p-8 text-center backdrop-blur-sm sm:p-12"
        data-success
        hidden
        tabindex="-1"
      >
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-brand-400/50 bg-brand-400/12 text-brand-200">
          <Icon name="check" size={26} />
        </span>

        <h3 class="mt-6 text-h2 font-semibold text-fg">{form.successTitle}</h3>
        <p class="mx-auto mt-4 max-w-lg text-[0.9375rem] leading-relaxed text-fg-muted">
          {form.successBody}
        </p>

        <div class="mx-auto mt-9 max-w-md text-left">
          <p class="font-mono text-[0.6875rem] tracking-[0.16em] text-fg-faint uppercase">
            {form.successMeta}
          </p>
          <ol class="mt-4 space-y-3.5">
            {form.successSteps.map((stepText, index) => (
              <li class="flex items-start gap-3.5">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-line-strong bg-ink-850 font-mono text-[0.6875rem] text-brand-300">
                  {index + 1}
                </span>
                <span class="text-[0.9375rem] text-fg-muted">{stepText}</span>
              </li>
            ))}
          </ol>
        </div>

        <Button id="wizard-restart" variant="secondary" class="mt-9" track="form_restart">
          {form.startOver}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------------------------------------------------------------
     Field primitives. Kept as scoped CSS because the same 6 patterns
     repeat ~30 times below; Tailwind strings would drown the markup.
     --------------------------------------------------------------- */

  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---- Step progress ---- */
  .steps {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .step {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }
  .step-dot {
    display: flex;
    height: 1.75rem;
    width: 1.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--color-line-strong);
    background: var(--color-ink-900);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-fg-faint);
    transition:
      background-color 320ms var(--ease-out-expo),
      border-color 320ms var(--ease-out-expo),
      color 320ms var(--ease-out-expo),
      box-shadow 320ms var(--ease-out-expo);
  }
  .step-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-fg-faint);
    transition: color 320ms var(--ease-out-expo);
    white-space: nowrap;
  }
  .step[data-state='active'] .step-dot {
    border-color: rgb(52 214 238 / 60%);
    background: rgb(52 214 238 / 14%);
    color: var(--color-brand-200);
    box-shadow: 0 0 0 4px rgb(52 214 238 / 8%);
  }
  .step[data-state='active'] .step-label {
    color: var(--color-fg);
  }
  .step[data-state='done'] .step-dot {
    border-color: rgb(52 214 238 / 45%);
    background: rgb(52 214 238 / 22%);
    color: var(--color-brand-200);
  }
  .step[data-state='done'] .step-label {
    color: var(--color-fg-subtle);
  }

  .step-track {
    margin-top: 1rem;
    height: 2px;
    border-radius: 9999px;
    background: var(--color-line);
    overflow: hidden;
  }
  .step-track > span {
    display: block;
    height: 100%;
    width: 33.333%;
    border-radius: 9999px;
    background: linear-gradient(90deg, var(--color-brand-500), var(--color-violet-500));
    transition: width 480ms var(--ease-out-expo);
  }

  /* ---- Alert ---- */
  .alert {
    margin-bottom: 1.75rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(251 191 36 / 35%);
    background: rgb(251 191 36 / 9%);
    padding: 0.875rem 1rem;
    font-size: 0.875rem;
    color: #fde68a;
  }

  /* ---- Step panels ---- */
  .step-heading {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-fg);
  }
  .step-heading:focus-visible {
    outline: none;
  }
  .step-kicker {
    display: block;
    margin-bottom: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand-300);
  }
  .step-help {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-fg-faint);
  }

  /* ---- Field groups ---- */
  .field-group {
    margin-top: 1.75rem;
  }
  .field-group > label,
  .field-group > legend {
    display: block;
    margin-bottom: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-fg-muted);
  }
  .field-group > legend {
    padding: 0;
  }

  .req {
    color: var(--color-brand-400);
  }

  /* ---- Text inputs ---- */
  input[type='text'],
  input[type='url'],
  input[type='email'],
  textarea,
  select {
    display: block;
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line-strong);
    background: rgb(5 7 11 / 60%);
    padding: 0.75rem 0.9375rem;
    font-size: 0.9375rem;
    color: var(--color-fg);
    transition:
      border-color 260ms var(--ease-out-expo),
      background-color 260ms var(--ease-out-expo),
      box-shadow 260ms var(--ease-out-expo);
  }
  input::placeholder,
  textarea::placeholder {
    color: var(--color-ink-600);
  }
  input[type='text']:hover,
  input[type='url']:hover,
  input[type='email']:hover,
  textarea:hover,
  select:hover {
    border-color: rgb(255 255 255 / 26%);
  }
  input[type='text']:focus,
  input[type='url']:focus,
  input[type='email']:focus,
  textarea:focus,
  select:focus {
    outline: none;
    border-color: rgb(52 214 238 / 65%);
    background: rgb(5 7 11 / 80%);
    box-shadow: 0 0 0 4px rgb(52 214 238 / 12%);
  }
  /* Error state is driven by [aria-invalid] so it stays in sync with what
     assistive tech is told, not just what is painted. */
  input[aria-invalid='true'],
  textarea[aria-invalid='true'],
  select[aria-invalid='true'] {
    border-color: rgb(251 191 36 / 60%);
    box-shadow: 0 0 0 4px rgb(251 191 36 / 10%);
  }

  select {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--color-fg-subtle) 50%),
      linear-gradient(135deg, var(--color-fg-subtle) 50%, transparent 50%);
    background-position:
      calc(100% - 1.25rem) calc(50% + 1px),
      calc(100% - 0.9375rem) calc(50% + 1px);
    background-size:
      5px 5px,
      5px 5px;
    background-repeat: no-repeat;
    padding-right: 2.5rem;
  }

  textarea {
    resize: vertical;
    min-height: 4.5rem;
  }

  .field-hint {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-fg-faint);
  }

  .field-error {
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: #fcd34d;
  }
  .field-error::before {
    content: '!';
    display: flex;
    height: 1rem;
    width: 1rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid currentColor;
    font-size: 0.625rem;
    font-weight: 700;
  }

  /* ---- Choice controls ---- */
  .stack {
    display: grid;
    gap: 0.625rem;
  }

  .chip-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    display: inline-flex;
    cursor: pointer;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line-strong);
    background: rgb(255 255 255 / 3%);
    padding: 0.5rem 0.9375rem;
    font-size: 0.875rem;
    color: var(--color-fg-subtle);
    transition:
      border-color 260ms var(--ease-out-expo),
      background-color 260ms var(--ease-out-expo),
      color 260ms var(--ease-out-expo);
  }
  .chip:hover {
    border-color: rgb(255 255 255 / 26%);
    color: var(--color-fg);
  }
  .chip:has(input:checked) {
    border-color: rgb(52 214 238 / 55%);
    background: rgb(52 214 238 / 12%);
    color: var(--color-brand-200);
  }
  .chip:has(input:focus-visible) {
    outline: 2px solid var(--color-brand-300);
    outline-offset: 2px;
  }

  .radio {
    display: flex;
    cursor: pointer;
    align-items: center;
    gap: 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    padding: 0.6875rem 0.875rem;
    font-size: 0.9375rem;
    color: var(--color-fg-muted);
    transition:
      border-color 260ms var(--ease-out-expo),
      background-color 260ms var(--ease-out-expo),
      color 260ms var(--ease-out-expo);
  }
  .radio:hover {
    border-color: var(--color-line-strong);
    color: var(--color-fg);
  }
  .radio:has(input:checked) {
    border-color: rgb(52 214 238 / 45%);
    background: rgb(52 214 238 / 7%);
    color: var(--color-fg);
  }
  .radio:has(input:focus-visible) {
    outline: 2px solid var(--color-brand-300);
    outline-offset: 2px;
  }

  .check {
    display: flex;
    cursor: pointer;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-fg-subtle);
    margin-bottom: 0;
  }
  .check input {
    margin-top: 0.25rem;
    height: 1rem;
    width: 1rem;
    flex-shrink: 0;
    accent-color: var(--color-brand-400);
  }
  .check:has(input:focus-visible) {
    outline: 2px solid var(--color-brand-300);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  .link {
    color: var(--color-brand-300);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .link:hover {
    color: var(--color-brand-200);
  }

  /* ---- No-JS fallback ----
     Keyed on `html:not(.js)` rather than a `no-js` class: BaseLayout adds the
     `js` class from an inline script, so if that script never runs — or JS is
     disabled outright — this selector applies. Without it a no-JS visitor would
     be stranded on step 1 with a Next button that does nothing. */
  :global(html:not(.js)) [data-step][hidden] {
    display: block;
  }
  :global(html:not(.js)) .step-track,
  :global(html:not(.js)) #wizard-next,
  :global(html:not(.js)) #wizard-back {
    display: none;
  }
</style>
