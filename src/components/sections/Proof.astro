---
import Section from '~/components/ui/Section.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import Counter from '~/components/ui/Counter.astro';
import type { Dictionary } from '~/i18n';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;

const numericFor = (display: string): number | undefined => {
  const match = display.match(/^([\d.,]+)/);
  if (!match?.[1]) return undefined;
  const parsed = Number(match[1].replace(/,/g, ''));
  return Number.isFinite(parsed) ? parsed : undefined;
};
---

<Section id="proof" labelledBy="proof-heading">
  <div class="shell">
    <SectionHeader
      id="proof-heading"
      eyebrow={dict.proof.eyebrow}
      title={dict.proof.title}
      lead={dict.proof.lead}
    />

    <!-- Metrics -->
    <dl class="mt-14 grid gap-5 sm:grid-cols-3 lg:mt-16">
      {dict.proof.metrics.map((metric, index) => (
        <div
          class="relative overflow-hidden rounded-[var(--radius-card)] border border-line bg-gradient-to-b from-ink-850/80 to-ink-900/60 px-6 py-8 text-center backdrop-blur-sm"
          data-reveal
          style={`--reveal-delay:${index * 90}ms`}
        >
          <dd>
            <Counter
              display={metric.value}
              to={numericFor(metric.value)}
              class="block font-display text-4xl font-semibold tracking-tight text-gradient sm:text-5xl"
            />
          </dd>
          <dt class="mt-3 text-sm text-fg-subtle">{metric.label}</dt>
        </div>
      ))}
    </dl>

    <!-- Testimonials -->
    <div class="mt-6 grid gap-5 lg:grid-cols-3">
      {dict.proof.testimonials.map((quote, index) => (
        <figure
          class="edge-lit flex flex-col rounded-[var(--radius-card)] border border-line bg-ink-900/50 p-7 backdrop-blur-sm transition-[transform,border-color] duration-400 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:border-line-strong"
          data-reveal
          style={`--reveal-delay:${index * 80}ms`}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 32 32"
            width="26"
            height="26"
            fill="currentColor"
            class="text-brand-500/35"
            aria-hidden="true"
          >
            <path d="M13.3 6C8.2 8.1 5 12 5 17.1c0 3.4 2 5.6 4.9 5.6 2.4 0 4.2-1.8 4.2-4.1 0-2.2-1.6-3.8-3.7-3.8-.4 0-.8.1-1 .2.4-2 2.1-4 4.4-5.2zm13.4 0c-5.1 2.1-8.3 6-8.3 11.1 0 3.4 2 5.6 4.9 5.6 2.4 0 4.2-1.8 4.2-4.1 0-2.2-1.6-3.8-3.7-3.8-.4 0-.8.1-1 .2.4-2 2.1-4 4.4-5.2z" />
          </svg>

          <blockquote class="mt-5 flex-1">
            <p class="text-[0.9375rem] leading-relaxed text-fg-muted">{quote.quote}</p>
          </blockquote>

          <figcaption class="mt-7 flex items-center gap-3.5 border-t border-line pt-5">
            {/* Initials avatar: deliberate placeholder. Swap for real client
                  photography before launch — photos convert measurably better. */}
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-line-strong bg-ink-800 font-mono text-xs font-semibold text-brand-300"
              aria-hidden="true"
            >
              {quote.initials}
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-fg">{quote.name}</span>
              <span class="block truncate text-[0.8125rem] text-fg-faint">{quote.company}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="mt-8 text-center text-xs text-fg-faint">{dict.proof.testimonialPlaceholderNote}</p>
  </div>
</Section>
