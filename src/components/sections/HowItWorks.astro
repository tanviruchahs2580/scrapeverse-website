---
import Section from '~/components/ui/Section.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import type { Dictionary } from '~/i18n';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<Section id="process" labelledBy="process-heading">
  <div class="shell">
    <SectionHeader
      id="process-heading"
      eyebrow={dict.process.eyebrow}
      title={dict.process.title}
      lead={dict.process.lead}
    />

    <ol class="relative mt-16 grid gap-10 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4 lg:gap-8">
      {dict.process.steps.map((step, index) => (
        <li class="relative" data-reveal style={`--reveal-delay:${index * 90}ms`}>
          {/* Connector: horizontal on desktop, hidden on stacked layouts where
                it would read as a stray line. */}
          {index < dict.process.steps.length - 1 && (
            <span
              class="absolute top-6 left-[3.25rem] hidden h-px w-[calc(100%-2rem)] bg-gradient-to-r from-brand-500/50 to-transparent lg:block"
              aria-hidden="true"
            />
          )}

          <div class="relative flex items-center gap-4">
            <span class="relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-brand-500/40 bg-ink-900 font-mono text-sm font-semibold text-brand-300">
              {String(index + 1).padStart(2, '0')}
            </span>
          </div>

          <h3 class="mt-6 text-h3 font-semibold text-fg">{step.title}</h3>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-fg-subtle">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</Section>
