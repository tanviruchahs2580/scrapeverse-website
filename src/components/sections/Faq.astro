---
import Section from '~/components/ui/Section.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import Icon from '~/components/ui/Icon.astro';
import type { Dictionary } from '~/i18n';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<Section id="faq" labelledBy="faq-heading" tint>
  <div class="shell">
    <SectionHeader
      id="faq-heading"
      eyebrow={dict.faq.eyebrow}
      title={dict.faq.title}
      lead={dict.faq.lead}
      align="left"
      class="max-w-3xl"
    />

    <!-- Native <details> gives keyboard, screen-reader and no-JS behaviour for
         free; the chevron is animated purely from CSS. -->
    <div class="mt-12 divide-y divide-line overflow-hidden rounded-[var(--radius-card)] border border-line bg-ink-900/40 backdrop-blur-sm lg:mt-14">
      {dict.faq.items.map((item, index) => (
        <details
          name="faq"
          class="faq-item group"
          open={index === 0}
          data-reveal
          style={`--reveal-delay:${Math.min(index, 4) * 60}ms`}
        >
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 px-6 py-5 transition-colors duration-300 hover:bg-white/[0.03] sm:px-7 sm:py-6">
            <h3 class="text-base font-semibold text-fg sm:text-[1.0625rem]">{item.q}</h3>
            <span
              class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-line-strong text-fg-subtle transition-[transform,background-color,border-color,color] duration-400 ease-[var(--ease-out-expo)] group-open:rotate-45 group-open:border-brand-400/60 group-open:bg-brand-400/12 group-open:text-brand-200"
              aria-hidden="true"
            >
              <Icon name="plus" size={14} />
            </span>
          </summary>
          <div class="faq-answer px-6 pb-6 sm:px-7 sm:pb-7">
            <p class="max-w-3xl text-[0.9375rem] leading-relaxed text-fg-subtle">{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</Section>
