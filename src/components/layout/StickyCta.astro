---
import Button from '~/components/ui/Button.astro';
import { getDictionary, pathForLocale, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const href = `${pathForLocale('/', locale)}#request`;
---

<!--
  Mobile-only conversion bar. Hidden until the visitor scrolls past the hero,
  then dismissed permanently so it never covers the form.
-->
<div
  id="sticky-cta"
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-line bg-ink-950/92 px-4 pt-3 pb-4 backdrop-blur-xl transition-transform duration-450 ease-[var(--ease-out-expo)] sm:hidden"
  aria-hidden="true"
>
  <div class="flex items-center gap-3">
    <div class="min-w-0 flex-1">
      <p class="truncate text-[0.8125rem] font-semibold text-fg">{dict.stickyCta.label}</p>
      <p class="truncate text-xs text-fg-faint">{dict.form.subtitle}</p>
    </div>
    <Button href={href} size="sm" class="shrink-0" track="sticky_cta">
      {dict.nav.sampleCta}
    </Button>
  </div>

  <button
    type="button"
    id="sticky-cta-close"
    class="absolute top-1.5 right-2.5 flex h-7 w-7 items-center justify-center rounded-lg text-fg-faint transition-colors hover:text-fg"
    aria-label={dict.stickyCta.hide}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width="13"
      height="13"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </button>
</div>
