---
import Logo from '~/components/brand/Logo.astro';
import Icon from '~/components/ui/Icon.astro';
import { getDictionary, pathForLocale, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const home = pathForLocale('/', locale);
const year = new Date().getFullYear();

const contactEmail = 'hello@scrapeverse.com';

const columns = [
  {
    title: dict.footer.servicesTitle,
    links: dict.footer.services,
    hrefs: ['#capabilities', '#capabilities', '#capabilities', '#capabilities', '#capabilities'],
  },
  {
    title: dict.footer.companyTitle,
    links: dict.footer.company,
    hrefs: ['#process', '#pricing', '#compliance', '#faq', `${home}blog/`],
  },
  {
    title: dict.footer.legalTitle,
    links: dict.footer.legal,
    hrefs: [`${home}privacy/`, `${home}terms/`, `${home}data-processing/`, `${home}cookies/`],
  },
];
---

<footer class="relative border-t border-line bg-ink-900/60">
  <div class="shell py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,2fr)]">
      <!-- Brand -->
      <div class="max-w-sm">
        <a href={home} class="inline-flex rounded-lg" data-track="footer_logo">
          <Logo />
          <span class="sr-only">{dict.meta.siteName} — home</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-fg-subtle">{dict.footer.blurb}</p>

        <div class="mt-6 space-y-2.5">
          <a
            href={`mailto:${contactEmail}`}
            class="group inline-flex items-center gap-2 rounded-md text-sm text-fg-muted transition-colors hover:text-brand-200"
          >
            <Icon
              name="mail"
              size={15}
              class="text-fg-faint transition-colors group-hover:text-brand-300"
            />
            {contactEmail}
          </a>
          <p class="flex items-center gap-2 text-sm text-fg-faint">
            <Icon name="clock" size={15} />
            <span>
              {dict.footer.responseLabel}:{' '}
              <span class="text-fg-subtle">{dict.footer.responseValue}</span>
            </span>
          </p>
        </div>

        <ul class="mt-7 flex items-center gap-2">
          {[
            { icon: 'linkedin', label: 'LinkedIn' },
            { icon: 'github', label: 'GitHub' },
            { icon: 'x', label: 'X' },
          ].map((social) => (
            <li>
              <a
                href="#"
                class="flex h-9 w-9 items-center justify-center rounded-lg border border-line text-fg-faint transition-colors duration-250 hover:border-line-strong hover:bg-white/5 hover:text-fg"
                aria-label={social.label}
              >
                <Icon name={social.icon as 'linkedin'} size={16} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Link columns -->
      <div class="grid gap-10 sm:grid-cols-3">
        {columns.map((column) => (
          <nav aria-label={column.title}>
            <h2 class="font-mono text-xs font-semibold tracking-[0.16em] text-fg uppercase">
              {column.title}
            </h2>
            <ul class="mt-4 space-y-3">
              {column.links.map((label, index) => (
                <li>
                  <a
                    href={column.hrefs[index] ?? '#'}
                    class="inline-block text-sm text-fg-subtle transition-colors duration-250 hover:text-fg"
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <div class="mt-14 flex flex-col-reverse items-start justify-between gap-5 border-t border-line pt-8 sm:flex-row sm:items-center">
      <p class="text-[0.8125rem] text-fg-faint">
        © {year} {dict.meta.siteName}. {dict.footer.rights}
      </p>

      <button
        type="button"
        id="back-to-top"
        class="group inline-flex items-center gap-1.5 rounded-lg text-[0.8125rem] text-fg-subtle transition-colors hover:text-fg"
      >
        {dict.footer.backToTop}
        <Icon
          name="arrow-up-right"
          size={14}
          class="-rotate-90 transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover:-translate-y-0.5"
        />
      </button>
    </div>
  </div>
</footer>
