---
/**
 * ScrapeVerse brand mark.
 *
 * Concept: an aperture — a lens opening onto a structured grid. The outer ring
 * is the crawl boundary; the inner strokes are rows resolving into records.
 * Drawn on a 32-unit grid with a consistent stroke weight so it stays legible
 * from a 16px favicon up to the hero lockup.
 *
 * Accessibility: the SVG is always `aria-hidden`; the accessible name comes
 * from a visually hidden text node, which is far more reliable than an SVG
 * `<title>` for screen readers and for search engines.
 */

interface Props {
  class?: string;
  /** Renders the aperture glyph only, for tight spaces. */
  markOnly?: boolean;
}

const { class: className = '', markOnly = false } = Astro.props;

const gradientId = 'sv-aperture-gradient';
---

{markOnly ? (
  <span class:list={['inline-flex', className]}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 32 32"
      class="h-full w-full"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient
          id={gradientId}
          x1="4"
          y1="4"
          x2="28"
          y2="28"
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0%" stop-color="#7DE9F7"></stop>
          <stop offset="52%" stop-color="#12B8D6"></stop>
          <stop offset="100%" stop-color="#8B5CF6"></stop>
        </linearGradient>
      </defs>
      <rect width="32" height="32" rx="8" fill="#0A0E15"></rect>
      <circle
        cx="16"
        cy="16"
        r="10.5"
        fill="none"
        stroke={`url(#${gradientId})`}
        stroke-width="2"
      ></circle>
      <path
        d="M16 5.5a10.5 10.5 0 0 1 9.1 5.2"
        fill="none"
        stroke="#0A0E15"
        stroke-width="2.6"
        stroke-linecap="round"
      ></path>
      <g stroke="#7DE9F7" stroke-width="1.8" stroke-linecap="round">
        <path d="M12.4 12.6h7.2"></path>
        <path d="M12.4 16h5.2"></path>
        <path d="M12.4 19.4h3.2"></path>
      </g>
      <circle cx="9.4" cy="12.6" r="1.15" fill="#8B5CF6"></circle>
    </svg>
    <span class="sr-only">ScrapeVerse</span>
  </span>
) : (
  <span class:list={['inline-flex items-center gap-2.5', className]}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 32 32"
      class="h-8 w-8 shrink-0"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient
          id={gradientId}
          x1="4"
          y1="4"
          x2="28"
          y2="28"
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0%" stop-color="#7DE9F7"></stop>
          <stop offset="52%" stop-color="#12B8D6"></stop>
          <stop offset="100%" stop-color="#8B5CF6"></stop>
        </linearGradient>
      </defs>
      <rect width="32" height="32" rx="8" fill="#0A0E15"></rect>
      <circle
        cx="16"
        cy="16"
        r="10.5"
        fill="none"
        stroke={`url(#${gradientId})`}
        stroke-width="2"
      ></circle>
      <path
        d="M16 5.5a10.5 10.5 0 0 1 9.1 5.2"
        fill="none"
        stroke="#0A0E15"
        stroke-width="2.6"
        stroke-linecap="round"
      ></path>
      <g stroke="#7DE9F7" stroke-width="1.8" stroke-linecap="round">
        <path d="M12.4 12.6h7.2"></path>
        <path d="M12.4 16h5.2"></path>
        <path d="M12.4 19.4h3.2"></path>
      </g>
      <circle cx="9.4" cy="12.6" r="1.15" fill="#8B5CF6"></circle>
    </svg>
    <span class="sr-only">ScrapeVerse</span>
    <span
      aria-hidden="true"
      class="font-display text-[1.0625rem] font-semibold tracking-[-0.02em] text-fg"
    >
      ScrapeVerse
    </span>
  </span>
)}
