---
/**
 * HeroTerminal — an animated extraction session.
 *
 * This is the site's primary proof-of-work visual: instead of claiming
 * "we scrape things", it shows a scrape happening. Without it the hero is
 * text on a gradient, which is what the previous site shipped.
 *
 * Accessibility: the whole widget is `aria-hidden`. It duplicates information
 * already present as text elsewhere on the page, so announcing it would be
 * noise for screen-reader users. All motion respects reduced-motion, in which
 * case the terminal renders fully populated and static.
 */

const SEQUENCE = [
  {
    kind: 'cmd',
    text: 'scrapeverse extract --target "aurelia-shop.com/catalogue" --depth 5',
    ms: 1500,
  },
  { kind: 'resolve', label: 'Resolving target', detail: '200 OK · 182 ms', ms: 620 },
  { kind: 'render', label: 'JavaScript detected', detail: 'headless Chromium · 3.2 s', ms: 720 },
  { kind: 'crawl', label: 'Crawling 5 pages', detail: '1,204 nodes · 0 blocked', ms: 660 },
  { kind: 'parse', label: 'Mapping to schema', detail: 'products.v3 · 12 fields', ms: 600 },
  {
    kind: 'clean',
    label: 'Normalising & deduplicating',
    detail: '1,180 kept · 24 merged',
    ms: 700,
  },
  { kind: 'deliver', label: 'Delivering rows', detail: 'CSV + signed webhook', ms: 640 },
] as const;

const dotTone: Record<string, string> = {
  resolve: 'bg-brand-300',
  render: 'bg-violet-400',
  crawl: 'bg-brand-300',
  parse: 'bg-violet-400',
  clean: 'bg-brand-300',
  deliver: 'bg-ok-400',
};
---

<div class="terminal edge-lit" aria-hidden="true" data-terminal>
  <!-- Chrome -->
  <div class="flex items-center gap-3 border-b border-line px-4 py-3">
    <div class="flex gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
    </div>
    <p class="min-w-0 flex-1 truncate text-center font-mono text-xs text-fg-faint">
      scrapeverse · session_8f3a21 · live
    </p>
    <span class="inline-flex items-center gap-1.5 font-mono text-[0.6875rem] text-ok-400">
      <span class="relative flex h-1.5 w-1.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ok-400 opacity-60"></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-ok-400"></span>
      </span>
      LIVE
    </span>
  </div>

  <!-- Body -->
  <div class="px-4 py-4 font-mono text-[0.75rem] leading-[1.85] sm:px-5 sm:text-[0.8125rem]">
    <p class="data-term-line" data-kind="cmd" style="--i:0">
      <span class="text-brand-300">❯</span>
      <span class="ml-2 text-fg" data-term-cmd></span>
      <span class="caret" data-term-caret></span>
    </p>

    <ul class="mt-3 space-y-0.5">
      {SEQUENCE.filter((s) => s.kind !== 'cmd').map((step) => (
        <li class="data-term-line" data-kind={step.kind} style={`--i:${SEQUENCE.indexOf(step)}`}>
          <span
            class:list={[
              'mr-2 inline-block h-1.5 w-1.5 translate-y-px rounded-full',
              dotTone[step.kind],
            ]}
          />
          <span class="text-fg-muted">{step.label}</span>
          <span class="mx-2 text-ink-600">·</span>
          <span class="text-brand-200/90">{step.detail}</span>
        </li>
      ))}
    </ul>

    <!-- Result panel: the payload the visitor is actually paying for -->
    <div
      class="data-term-line mt-4 overflow-hidden rounded-xl border border-line bg-ink-950/60"
      data-kind="result"
      style="--i:8"
    >
      <div class="grid grid-cols-3 divide-x divide-line border-b border-line">
        <div class="px-3 py-2.5 text-center">
          <p class="font-display text-xl font-semibold text-fg sm:text-2xl">
            <span data-term-rows>1,180</span>
          </p>
          <p class="mt-0.5 text-[0.625rem] tracking-[0.1em] text-fg-faint uppercase">rows</p>
        </div>
        <div class="px-3 py-2.5 text-center">
          <p class="font-display text-xl font-semibold text-fg sm:text-2xl">99.4%</p>
          <p class="mt-0.5 text-[0.625rem] tracking-[0.1em] text-fg-faint uppercase">valid</p>
        </div>
        <div class="px-3 py-2.5 text-center">
          <p class="font-display text-xl font-semibold text-fg sm:text-2xl">5m 41s</p>
          <p class="mt-0.5 text-[0.625rem] tracking-[0.1em] text-fg-faint uppercase">elapsed</p>
        </div>
      </div>

      <div class="px-3 py-2">
        <div class="flex items-center gap-2">
          <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-ok-400/15">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="11"
              height="11"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-ok-400"
              aria-hidden="true"
              focusable="false"
            >
              <path d="m4.5 12.5 5 5 10-11"></path>
            </svg>
          </span>
          <p class="truncate text-fg-subtle">
            <span class="text-fg">products.csv</span> delivered to your S3 bucket
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .terminal {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-panel);
    background: linear-gradient(180deg, rgb(20 27 38 / 92%) 0%, rgb(10 14 21 / 96%) 100%);
    box-shadow: var(--shadow-panel);
    font-variant-ligatures: none;
  }

  /* Lines start hidden only when JS has taken over, so the static markup
     (used by reduced-motion and no-JS visitors) is fully legible. */
  :global(.js) [data-terminal] .data-term-line {
    opacity: 0;
    transition:
      opacity 260ms var(--ease-out-expo),
      transform 260ms var(--ease-out-expo);
    transform: translate3d(0, 6px, 0);
  }

  :global(.js) [data-terminal] .data-term-line.is-shown {
    opacity: 1;
    transform: none;
  }

  .caret {
    display: inline-block;
    width: 0.5rem;
    height: 1.05em;
    translate: 0 0.16em;
    background: var(--color-brand-300);
    animation: caret-blink 1.1s steps(2, start) infinite;
  }

  @keyframes caret-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }

    :global(.js) [data-terminal] .data-term-line {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  const SEQUENCE_MS = [1500, 620, 720, 660, 600, 700, 640, 640] as const;

  const COMMAND = 'scrapeverse extract --target "aurelia-shop.com/catalogue" --depth 5';

  function sleep(ms: number) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  function initTerminals() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    for (const terminal of document.querySelectorAll<HTMLElement>('[data-terminal]')) {
      const lines = Array.from(terminal.querySelectorAll<HTMLElement>('.data-term-line'));
      const commandTarget = terminal.querySelector<HTMLElement>('[data-term-cmd]');
      const caret = terminal.querySelector<HTMLElement>('[data-term-caret]');

      const reset = () => {
        lines.forEach((line) => line.classList.remove('is-shown'));
        if (commandTarget) commandTarget.textContent = '';
      };

      const showAll = () => {
        if (commandTarget) commandTarget.textContent = COMMAND;
        caret?.remove();
        lines.forEach((line) => line.classList.add('is-shown'));
      };

      // Static presentation: reduced motion, or JS present but no animation wanted.
      if (reduced) {
        showAll();
        continue;
      }

      const run = async () => {
        reset();
        await sleep(400);

        if (commandTarget) {
          for (let i = 1; i <= COMMAND.length; i += 2) {
            commandTarget.textContent = COMMAND.slice(0, i);
            await sleep(16);
          }
        }
        await sleep(320);
        caret?.remove();

        for (const [index, line] of lines.entries()) {
          if (index === 0) continue;
          line.classList.add('is-shown');
          await sleep(SEQUENCE_MS[index] ?? 520);
        }

        // Hold the finished state long enough to actually read it.
        await sleep(5200);
        await sleep(400);
        await run();
      };

      // Only animate while the terminal is on screen.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            void run();
          }
        },
        { threshold: 0.25 },
      );
      observer.observe(terminal);

      reset();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTerminals, { once: true });
  } else {
    initTerminals();
  }
</script>
