---
import Aurora from '~/components/ui/Aurora.astro';
import { LEGAL_DOCS, LEGAL_UPDATED, type LegalDoc } from '~/content/legal';
import { getDictionary, pathForLocale, type Locale } from '~/i18n';

interface Props {
  doc: LegalDoc;
  locale: Locale;
}

const { doc, locale } = Astro.props;
const dict = getDictionary(locale);
---

<article class="relative overflow-hidden">
  <Aurora position="top" />

  <div class="shell relative py-20 lg:py-28">
    <header class="max-w-2xl" data-reveal>
      <p class="eyebrow">{dict.footer.legalTitle}</p>
      <h1 class="mt-6 text-h2 font-semibold text-fg">{doc.title}</h1>
      <p class="mt-4 text-lead text-fg-muted">{doc.description}</p>
      <p class="mt-6 font-mono text-xs text-fg-faint">
        {dict.legal.lastUpdated}: {LEGAL_UPDATED}
      </p>
    </header>

    <div class="mt-14 max-w-2xl lg:mt-16">
      {doc.sections.map((section, index) => (
        <section
          class="mb-11 last:mb-0"
          data-reveal
          style={`--reveal-delay:${Math.min(index, 5) * 50}ms`}
        >
          <h2 class="text-h3 font-semibold text-fg">{section.heading}</h2>
          <div class="prose-sv prose-sv-dark mt-3.5 max-w-none text-[0.9375rem] leading-relaxed text-fg-subtle">
            {section.body.map((paragraph) => (
              <p class="mt-3">{paragraph}</p>
            ))}
          </div>

          {section.placeholder && (
            <p
              class="mt-4 flex items-start gap-2.5 rounded-xl border border-warn-400/30 bg-warn-400/[0.07] px-4 py-3 text-[0.8125rem] leading-relaxed text-warn-400"
              lang={locale === 'en' ? 'en' : 'bn'}
            >
              <span aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7.8v4.8" />
                  <path d="M12 15.8h.01" />
                </svg>
              </span>
              {locale === 'en'
                ? 'Placeholder — this clause needs sign-off from a qualified lawyer before launch.'
                : 'প্লেসহোল্ডার — চালু করার আগে অংশগ্রহণকারী আইনি পরামর্শকের অনুমোদন প্রয়োজন।'}
            </p>
          )}
        </section>
      ))}

      <nav class="mt-16 border-t border-line pt-8" aria-label={dict.footer.legalTitle}>
        <p class="font-mono text-[0.6875rem] tracking-[0.16em] text-fg-faint uppercase">
          {dict.footer.legalTitle}
        </p>
        <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          {(Object.keys(LEGAL_DOCS[locale]) as LegalDoc['slug'][]).map((slug) => (
            <li>
              <a
                href={
                  slug === doc.slug
                    ? undefined
                    : pathForLocale(
                        `/${slug === 'data-processing' ? 'data-processing' : slug}/`,
                        locale,
                      )
                }
                aria-current={slug === doc.slug ? 'page' : undefined}
                class:list={[
                  'text-sm transition-colors duration-300',
                  slug === doc.slug ? 'text-fg' : 'text-fg-subtle hover:text-brand-300',
                ]}
              >
                {LEGAL_DOCS[locale][slug].title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</article>
