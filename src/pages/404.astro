---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Aurora from '~/components/ui/Aurora.astro';
import Button from '~/components/ui/Button.astro';
import Icon, { type IconName } from '~/components/ui/Icon.astro';
import { getDictionary, pathForLocale } from '~/i18n';

/**
 * Static hosts serve one 404 document for the whole origin, so this page is
 * English with an explicit Bangla route rather than a second translated copy
 * that would never be served.
 */
const locale = 'en' as const;
const dict = getDictionary(locale);
const nf = dict.notFound;

const destinations: { href: string; label: string; icon: IconName }[] = [
  { href: pathForLocale('/#capabilities', 'en'), label: dict.nav.services, icon: 'filter' },
  { href: pathForLocale('/#process', 'en'), label: dict.nav.process, icon: 'clock' },
  { href: pathForLocale('/#pricing', 'en'), label: dict.nav.pricing, icon: 'layers' },
  { href: pathForLocale('/blog/', 'en'), label: dict.nav.blog, icon: 'sparkle' },
];
---

<BaseLayout
  locale={locale}
  title={`${nf.code} — ${nf.title}`}
  description={nf.lead}
  pathname="/404/"
  // Static hosts serve one 404 document for the whole origin, so there is no
  // `/bd/404/` to switch to. Send the visitor to the Bangla homepage instead.
  altPathname="/bd/"
  noindex
>
  <section class="relative overflow-hidden">
    <Aurora position="top" grain />

    <div class="shell relative py-24 lg:py-32">
      <div class="mx-auto max-w-2xl text-center">
        <p class="font-mono text-[4.5rem] leading-none font-bold text-gradient sm:text-[6rem]">
          {nf.code}
        </p>

        <h1 class="mt-6 text-h2 font-semibold text-fg">{nf.title}</h1>
        <p class="mx-auto mt-5 max-w-xl text-lead text-fg-muted">{nf.lead}</p>

        <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
          <Button href={pathForLocale('/', 'en')} size="lg" icon="arrow-right" track="404_home">
            {nf.cta}
          </Button>
          <Button href={pathForLocale('/blog/', 'en')} size="lg" variant="secondary" icon="sparkle">
            {nf.secondary}
          </Button>
        </div>

        <ul class="mt-14 grid gap-3 sm:grid-cols-2">
          {destinations.map((destination) => (
            <li>
              <a
                href={destination.href}
                class="flex items-center gap-3 rounded-xl border border-line bg-ink-900/50 px-4 py-3.5 text-left text-sm text-fg-muted transition-[border-color,background-color,transform] duration-300 ease-[var(--ease-out-expo)] hover:-translate-y-0.5 hover:border-brand-500/35 hover:bg-ink-850/70 hover:text-fg"
              >
                <Icon name={destination.icon} size={17} class="shrink-0 text-brand-300" />
                {destination.label}
                <Icon name="arrow-right" size={15} class="ml-auto text-fg-faint" />
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-12 text-sm text-fg-faint">
          <a
            href="/bd/"
            hreflang="bn-BD"
            lang="bn"
            class="text-brand-300 underline underline-offset-4 hover:text-brand-200"
          >
            {dict.nav.switchToBd}
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
