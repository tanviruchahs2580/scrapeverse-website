---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Aurora from '~/components/ui/Aurora.astro';
import Icon from '~/components/ui/Icon.astro';
import Button from '~/components/ui/Button.astro';
import { getDictionary, pathForLocale, type Locale } from '~/i18n';

export async function getStaticPaths() {
  return [{ params: {} }];
}

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getDictionary(locale);

const posts = (
  await getCollection('posts', (entry) => !entry.data.draft && entry.data.locale === locale)
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .map((entry) => ({
    slug: entry.id,
    href: `${pathForLocale('/blog/', locale)}${entry.id}/`,
    ...entry.data,
  }));

const dateFormat = new Intl.DateTimeFormat(locale === 'en' ? 'en-GB' : 'bn-BD', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout locale={locale} title={dict.blog.title} description={dict.blog.lead} pathname="/blog/">
  <section class="relative overflow-hidden">
    <Aurora position="top" grain />

    <div class="shell relative py-20 lg:py-28">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{dict.nav.blog}</p>
        <h1 class="mt-6 text-h2 font-semibold text-fg">{dict.blog.title}</h1>
        <p class="mt-5 text-lead text-fg-muted">{dict.blog.lead}</p>
      </div>

      {posts.length === 0 ? (
        <p class="mt-14 text-fg-subtle" data-reveal>
          {dict.blog.empty}
        </p>
      ) : (
        <div class="mt-14 grid gap-5 sm:grid-cols-2">
          {posts.map((post, index) => (
            <article
              class="edge-lit group relative flex flex-col rounded-[var(--radius-card)] border border-line bg-ink-900/50 p-7 backdrop-blur-sm transition-[transform,border-color,background-color] duration-400 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:border-brand-500/35 hover:bg-ink-850/70"
              data-reveal
              style={`--reveal-delay:${Math.min(index, 4) * 70}ms`}
            >
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <time
                  datetime={post.publishedAt.toISOString()}
                  class="font-mono text-[0.6875rem] text-fg-faint"
                >
                  {dateFormat.format(post.publishedAt)}
                </time>
                {post.tags.map((tag) => (
                  <span class="rounded-full border border-line bg-ink-850 px-2.5 py-1 font-mono text-[0.625rem] text-fg-faint">
                    {tag}
                  </span>
                ))}
              </div>

              <h2 class="mt-5 text-h3 font-semibold text-fg transition-colors duration-300 group-hover:text-brand-200">
                <a href={post.href} class="after:absolute after:inset-0 after:content-['']">
                  {post.title}
                </a>
              </h2>

              <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-fg-subtle">
                {post.description}
              </p>

              <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-300">
                {dict.blog.readMore}
                <Icon
                  name="arrow-right"
                  size={15}
                  class="transition-transform duration-300 group-hover:translate-x-1"
                />
              </span>
            </article>
          ))}
        </div>
      )}

      <div class="mt-16 flex justify-center" data-reveal>
        <Button href={pathForLocale('/', locale)} variant="secondary" icon="arrow-right">
          {dict.nav.home}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
