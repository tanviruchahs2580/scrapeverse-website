---
import BaseLayout from '~/layouts/BaseLayout.astro';
import LegalPage from '~/layouts/LegalPage.astro';
import { LEGAL_DOCS, type LegalDoc } from '~/content/legal';

export function getStaticPaths() {
  return (Object.keys(LEGAL_DOCS.bd) as LegalDoc['slug'][]).map((slug) => ({
    params: { doc: slug },
  }));
}

const locale = 'bd' as const;
const slug = Astro.params.doc as LegalDoc['slug'];
const doc = LEGAL_DOCS.bd[slug];
---

<BaseLayout
  locale={locale}
  title={doc.title}
  description={doc.description}
  pathname={`/bd/${slug}/`}
>
  <LegalPage doc={doc} locale={locale} />
</BaseLayout>
